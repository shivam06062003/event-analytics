          "legendFormat": "p95 insert",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(processor_duplicates_total[1m]))",
          "legendFormat": "duplicates/s",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
